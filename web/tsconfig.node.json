{
    "extends": "@vue/tsconfig/tsconfig.json",
    "include": ["vite.config.ts"],
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "target": "ES2022",
        "lib": ["ES2023"],
        "types": ["node"],
        "noEmit": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    }
}
