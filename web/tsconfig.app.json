{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "include": ["env.d.ts", "src/**/*"],
    "exclude": ["src/**/*.test.*", "src/**/__tests__/**", "src/test/**", "src/testSetup.*"],
    "compilerOptions": {
        // Never under `dist/`: rust-embed ships everything there.
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        // `async` must survive: `test/mockApi.ts` finds endpoints by `constructor.name === 'AsyncFunction'`.
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client"],
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        // Until every file is TypeScript: a `.ts` file is checked strictly, a `.js` one not at all.
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    }
}
